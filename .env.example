# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Matches docker-compose.yml. Start the database with: npm run db:up
DATABASE_URL="postgresql://carnac:carnac@localhost:5432/carnac?schema=public"

# Any random string works locally. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Optional: the product's name and logo for this site (droplets, zap, flame or
# network). Unset, the site shows the ones stored with its branding.
# PRODUCT_NAME="Hydrocore"
# PRODUCT_LOGO="droplets"

# Optional: MapLibre basemap style URL. Defaults to CARTO Voyager.
# NEXT_PUBLIC_MAP_STYLE=

# ---------------------------------------------------------------------------
# Production (set these in the Vercel dashboard, never in a committed file)
# ---------------------------------------------------------------------------
# DATABASE_URL   Neon pooled connection string. Must be a PostGIS-capable
#                Postgres — the network map stores real geometry, and the
#                initial migration runs CREATE EXTENSION postgis.
#
# AUTH_SECRET    A NEW random 32-byte value, not the local one. Changing it
#                invalidates every existing session.
#
# NEXTAUTH_URL   The deployed origin, e.g. https://carnac.vercel.app
#                Must match exactly or sign-in redirects break.
#
# PRODUCT_NAME   The product's name for this site, e.g. Hydrocore or
# PRODUCT_LOGO   Powercore, and its logo. Set here, not in the app, so a
#                customer's Administrator cannot change them.
#
# See DEPLOYMENT.md for the full walkthrough.
